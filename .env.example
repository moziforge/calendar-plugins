# Credentials for @moziforge/calendar-icloud-plugin.
#
# Apple ID that owns the calendars. An email address, not a password.
ICLOUD_ACCOUNT=you@example.com

# App-specific password generated at https://appleid.apple.com ("App-Specific
# Passwords"). The Apple ID account password does NOT work over CalDAV once
# two-factor authentication is enabled, which is why this separate secret exists.
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: override the CalDAV entry point. iCloud redirects discovery through
# https://caldav.icloud.com/.well-known/caldav, so the default is correct unless
# the account lives on a different DAV host.
# ICLOUD_CALDAV_SERVER_URL=https://caldav.icloud.com/
