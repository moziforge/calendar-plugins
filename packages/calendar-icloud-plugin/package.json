    "tsdav": "^2.3.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@types/node": "^24.3.0",
    "oxlint": "^1.12.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "repository": {
