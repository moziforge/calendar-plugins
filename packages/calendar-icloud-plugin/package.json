{
  "name": "@moziforge/calendar-icloud-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH plugin that reads and writes Apple iCloud Calendar over CalDAV.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "caldav",
    "icalendar",
    "icloud",
    "calendar"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./host": "./dist/host.js",
    "./tools": "./dist/tools.js",
    "./client": "./dist/client.js",
    "./ical": "./dist/ical.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
